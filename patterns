

# NGS REGISTRY PATTERNS
# One regular expression per line

^[A-Z][a-z]{3}[0-9]{8}[a-z][0-9][a-z][0-9]$
^[A-Z][@#$][0-9]{6}[@#$][0-9][a-z][0-9]$
^[A-Z][@#$][0-9]{2}[A-Z][0-9][,.;][0-9][@#$][0-9][a-z][0-9]$
^[A-Z][@#$][A-Z][0-9][_][0-9][,.;][0-9][@#$][_][a-z][0-9]$
^[A-Z][@#$][A-Z][0-9][_][0-9][,.;][0-9][@#$][_][a-z][0-9][_][a-z][@#$][=+][A-Z]$
^[_][@#$][_][0-9][_][0-9][,.;][A-Z][@#$][_][a-z][+][_][a-z][@#$][=+][A-Z]$
^[_][=+][@#$][_][,.;][a-z][0-9][,.;][A-Z][@#$][_][a-z][+][_][a-z][@#$][=+][@#$]$
^[_][=+][@#$][*][,.;][a-z]\^[,.;][@#$][@#$][_][a-z][+][_][;.;][@#$][=+][@#$]$
^[%][*][@#$][*][!][a-z]\^[,.;][@#$][a-z][_][a-z][+][_][;.;][!][=+][@#$]$
^[%][a-z][@#$][*][!][^*][A-z][,.;][@#$][*][_][a-z][*][_][&][a-z][=+][=]$
